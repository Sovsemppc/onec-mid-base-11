#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКомандуЗаполнить()
	// ++ Арканов Д.Ю. доработка дипломной работы
	
	НоваяКоманда = Команды.Добавить("Заполнить");
    
    НоваяКоманда.Действие  = "КомандаЗаполнить";
    НоваяКоманда.Заголовок = "Заполнить";
    НоваяКоманда.Подсказка = "Заполнить";
	
    НоваяКнопка = Элементы.Добавить("Заполнить", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
    НоваяКнопка.ИмяКоманды   = "Заполнить";
    НоваяКнопка.Вид          = ВидКнопкиФормы.КнопкаКоманднойПанели;
	// -- Арканов Д.Ю. доработка дипломной работы
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнить()
	// ++ Арканов Д.Ю. доработка дипломной работы
	
	ВидДоговора = ПолучитьВидДоговора(Объект.Договор);
	Если ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание") Тогда
		КомандаЗаполнитьНаСервере();
	КонецЕсли;
	// -- Арканов Д.Ю. доработка дипломной работы
КонецПроцедуры

&НаСервере
Процедура КомандаЗаполнитьНаСервере()
	// ++ Арканов Д.Ю. доработка дипломной работы
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.ВыполнитьАвтозаполнение();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	// -- Арканов Д.Ю. доработка дипломной работы
КонецПроцедуры

&НаСервере
Функция ПолучитьВидДоговора(Договор)
	// ++ Арканов Д.Ю. доработка дипломной работы
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Договор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ВыборкаДетальныеЗаписи.Следующий();
	
	Возврат ВыборкаДетальныеЗаписи.ВидДоговора;
	// -- Арканов Д.Ю. доработка дипломной работы
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

