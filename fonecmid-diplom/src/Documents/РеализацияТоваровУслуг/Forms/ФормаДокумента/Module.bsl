	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ++ Арканов Д.Ю. доработка дипломной работы
	ДобавитьКомандуЗаполнить();
	// -- Арканов Д.Ю. доработка дипломной работы
КонецПроцедуры

