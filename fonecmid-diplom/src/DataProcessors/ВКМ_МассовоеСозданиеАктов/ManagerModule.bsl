#Область ПрограммныйИнтерфейс

// Формирует (или находит уже существующие) реализации по остаткам выполненных работ
// за указанный период по всем действующим абонентским договорам.
//
// Параметры:
//  Параметры - Структура - параметры выполнения длительной операции:
//   * АдресРезультата  - Строка - адрес временного хранилища для результата
//   * Период           - Дата   - дата, по которую формируются акты (обычно конец месяца)
//
Процедура СформироватьАкты(Параметры) Экспорт
	
	АдресРезультата = Параметры.АдресРезультата;
	Период          = Параметры.Период;
	
	// Все договора с видом "ВКМ_АбонентскоеОбслуживание" Действующие на дату("Период")
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	ДоговорыКонтрагентов.Организация КАК Организация,
	|	ДоговорыКонтрагентов.Владелец КАК Контрагент,
	|	ДоговорыКонтрагентов.ВидДоговора КАК ВидДоговора
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора
	|	И &Период МЕЖДУ ДоговорыКонтрагентов.ВКМ_ДатаНачала И ДоговорыКонтрагентов.ВКМ_ДатаОкончания";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);
	
	ТаблицаДоговоров = Запрос.Выполнить().Выгрузить();
	ВсегоДоговоров   = ТаблицаДоговоров.Количество();
	
	Если ВсегоДоговоров = 0 Тогда
		ДлительныеОперации.СообщитьПрогресс(0, "Нет действующих абонентских договоров с остатком к оплате");
		ПоместитьВоВременноеХранилище(Новый Массив, АдресРезультата);
		Возврат;
	КонецЕсли;
	// Все договора с видом "ВКМ_АбонентскоеОбслуживание" Действующие на дату("Период")
	
	// Запрос существующих реализаций где договор В &ТаблицаДоговоров и дата реализации в месяце &Периода
	ЗапросСуществующие = Новый Запрос;
	ЗапросСуществующие.Текст =
	"ВЫБРАТЬ
	|	Реализация.Договор КАК Договор,
	|	Реализация.Ссылка  КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|ГДЕ
	|	Реализация.Проведен
	|	И Реализация.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
	|	И Реализация.Договор В (&ТаблицаДоговоров)";
	
	ЗапросСуществующие.УстановитьПараметр("Период", Период);
	ЗапросСуществующие.УстановитьПараметр("ТаблицаДоговоров", ТаблицаДоговоров.ВыгрузитьКолонку("Договор"));
	
	СоответствиеРеализаций = Новый Соответствие;
	Выборка = ЗапросСуществующие.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеРеализаций.Вставить(Выборка.Договор, Выборка.Ссылка);
	КонецЦикла;
	// Запрос существующих реализаций где договор В &ТаблицаДоговоров и дата реализации в месяце &Периода
	
	Результат = Новый Массив;
	Создано   = 0;
	Номер     = 0;
	
	Для Каждого СтрокаДоговора Из ТаблицаДоговоров Цикл
		Номер = Номер + 1;
		Процент = Окр(Номер * 100 / ВсегоДоговоров, 0);
		
		ТекстПрогресса = СтрШаблон("Обработка договора %1 из %2 (%3)…",
			Номер, ВсегоДоговоров, СтрокаДоговора.Договор);
		
		ДлительныеОперации.СообщитьПрогресс(Процент, ТекстПрогресса);
		РеализацияСсылка = СоответствиеРеализаций[СтрокаДоговора.Договор];
		
		Если НЕ ЗначениеЗаполнено(РеализацияСсылка) Тогда
			Попытка
				Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
				Док.Дата        = Период;
				Док.Организация = СтрокаДоговора.Организация;
				Док.Контрагент  = СтрокаДоговора.Контрагент;
				Док.Договор     = СтрокаДоговора.Договор;
				
				Док.Заполнить(Неопределено);
				Док.ВыполнитьАвтозаполнение(); // ← здесь всё ещё запрос, но это уже логика самого документа
				
				Если Док.ПроверитьЗаполнение() Тогда
					Док.Записать(РежимЗаписиДокумента.Проведение);
					РеализацияСсылка = Док.Ссылка;
					Создано = Создано + 1;
				Иначе
					Продолжить;
				КонецЕсли;
			Исключение
				ИнфоОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфоОбОшибке);
				
				ЗаписьЖурналаРегистрации(
					"МассовоеСозданиеАктов.ОшибкаПроведения",
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					ТекстОшибки);
				Продолжить;
			КонецПопытки;
		КонецЕсли;
				
		Если ЗначениеЗаполнено(РеализацияСсылка) Тогда
			Результат.Добавить(Новый Структура("Договор, Реализация",
				СтрокаДоговора.Договор, РеализацияСсылка));
		КонецЕсли;
	КонецЦикла;
	
	Если Результат.Количество() = 0 Тогда
		ДлительныеОперации.СообщитьПрогресс(100, "Реализации не созданы и не найдены");
	Иначе
		ТекстИтог = СтрШаблон("Готово. Обработано договоров: %1, создано новых: %2, всего актов: %3",
			ВсегоДоговоров, Создано, Результат.Количество());
		ДлительныеОперации.СообщитьПрогресс(100, ТекстИтог);
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

#КонецОбласти
